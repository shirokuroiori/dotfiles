{
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/deny-push-hook.sh",
            "timeout": 10,
            "statusMessage": "push 禁止チェック"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "editorMode": "vim"
}
