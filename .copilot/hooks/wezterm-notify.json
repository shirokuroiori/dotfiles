{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/wezterm-notify.sh pretool",
        "timeoutSec": 5
      }
    ],
    "notification": [
      {
        "type": "command",
        "matcher": "permission_prompt|elicitation_dialog",
        "bash": "~/.copilot/hooks/wezterm-notify.sh waiting",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/wezterm-notify.sh done",
        "timeoutSec": 5
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/wezterm-notify.sh done",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/wezterm-notify.sh done",
        "timeoutSec": 5
      }
    ]
  }
}
