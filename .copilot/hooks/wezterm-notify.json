{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "~/.local/bin/wezterm-agents hook --agent copilot working",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "~/.local/bin/wezterm-agents hook --agent copilot pretool",
        "timeoutSec": 5
      }
    ],
    "notification": [
      {
        "type": "command",
        "matcher": "permission_prompt|elicitation_dialog",
        "bash": "~/.local/bin/wezterm-agents hook --agent copilot waiting",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "~/.local/bin/wezterm-agents hook --agent copilot done",
        "timeoutSec": 5
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "~/.local/bin/wezterm-agents hook --agent copilot done",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "~/.local/bin/wezterm-agents hook --agent copilot done",
        "timeoutSec": 5
      }
    ]
  }
}
